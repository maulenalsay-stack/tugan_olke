[{"d": 1, "cat": "maqal", "kk": "Өнер алды — қызыл тіл.", "ru": "Первое из искусств — красноречие.", "note": "«Қызыл тіл» — шешендік, сөз өнері.", "q": "«Қызыл тіл» дегеніміз не?", "o": ["Шешендік, әдемі сөйлеу", "Қызыл түсті тіл", "Ауырған тіл"], "mk": ["қызыл", "тіл"], "all": false, "wrong": null, "nosub": false, "id": "01-1"}, {"d": 1, "cat": "maqal", "kk": "Сәлем — сөздің анасы.", "ru": "Приветствие — мать всех слов.", "note": "Әңгіме әрқашан сәлемнен басталады.", "q": "Әңгімені неден бастаймыз?", "o": ["Сәлемнен", "Сұрақтан", "Қоштасудан"], "mk": ["Сәлем"], "all": false, "wrong": null, "nosub": false, "id": "01-2"}, {"d": 1, "cat": "maqal", "kk": "Жақсы сөз — жарым ырыс.", "ru": "Доброе слово — половина счастья.", "note": "«Ырыс» — бақыт, береке.", "q": "«Ырыс» сөзінің мағынасы:", "o": ["Бақыт", "Сөз", "Жол"], "mk": ["ырыс"], "all": false, "wrong": null, "nosub": false, "id": "01-3"}, {"d": 1, "cat": "maqal", "kk": "Әдепті бала — арлы бала.", "ru": "Воспитанный ребёнок — совестливый ребёнок.", "note": "«Әдеп» — тәрбие, сыпайылық.", "q": "«Әдепті» дегені:", "o": ["Тәрбиелі", "Ақылды", "Күшті"], "mk": ["Әдепті"], "all": false, "wrong": null, "nosub": false, "id": "01-4"}, {"d": 2, "cat": "sozdik", "kk": "Сәлеметсіз бе!", "ru": "Здравствуйте!", "note": "«-сіз» — сыпайы түр. Досыңа: «Сәлем!»", "q": "Досыңмен қалай амандасасың?", "o": ["Сәлем!", "Сәлеметсіз бе!", "Сау болыңыз!"], "mk": ["сіз"], "all": false, "wrong": null, "nosub": false, "id": "02-1"}, {"d": 2, "cat": "sozdik", "kk": "Қалайсың?\nЖақсы, рахмет!", "ru": "Как ты? — Хорошо, спасибо!", "note": "«-сың» — «сен» деген адамға. Сыпайы түрі: «Қалайсыз?»", "q": "Мұғалімнен қалай сұрайсың?", "o": ["Қалайсыз?", "Қалайсың?", "Қалай?"], "mk": ["сың"], "all": false, "wrong": null, "nosub": false, "id": "02-2"}, {"d": 2, "cat": "sozdik", "kk": "Менің атым Олжас.\nСенің атың кім?", "ru": "Меня зовут Олжас. Как тебя зовут?", "note": "«атым» — менің атым, «атың» — сенің атың.", "q": "«Как тебя зовут?» қазақша:", "o": ["Сенің атың кім?", "Менің атым кім?", "Сен кімсің?"], "mk": ["атым", "атың"], "all": false, "wrong": null, "nosub": false, "id": "02-3"}, {"d": 2, "cat": "sozdik", "kk": "Танысқаныма қуаныштымын!", "ru": "Рад познакомиться!", "note": "Танысқанда осылай айтамыз.", "q": "Танысқанда не дейміз?", "o": ["Танысқаныма қуаныштымын!", "Сау бол!", "Кешіріңіз!"], "mk": ["қуаныштымын"], "all": false, "wrong": null, "nosub": false, "id": "02-4"}, {"d": 3, "cat": "gram", "kk": "кітап, кітаптар.\nбала, балалар.\nқыз, қыздар.", "ru": "Множественное число: -тар, -лар, -дар", "note": "Дауысты, р, й, у → -лар. Ж, з, л, м, н, ң → -дар. Қатаң дыбыс → -тар.", "q": "«Дос» сөзінің көпше түрі:", "o": ["достар", "достлар", "достер"], "mk": ["тар", "лар", "дар"], "all": false, "wrong": null, "nosub": false, "id": "03-1"}, {"d": 3, "cat": "gram", "kk": "Мен оқушымын.\nСен оқушысың.\nОл оқушы.", "ru": "Я ученик. Ты ученик. Он ученик.", "note": "Жіктік жалғау: мен → -мын/-мін, сен → -сың/-сің, ол → жалғаусыз.", "q": "«Мен мұғалім__»", "o": ["мұғаліммін", "мұғалімсің", "мұғалімбін"], "mk": ["мын", "сың"], "all": false, "wrong": null, "nosub": false, "id": "03-2"}, {"d": 3, "cat": "gram", "kk": "Сен оқушысың ба?\nБұл кітап па?", "ru": "Ты ученик? Это книга?", "note": "Сұрақ шылауы: ма/ме, ба/бе, па/пе. Сөздің соңғы дыбысына қарай таңдалады.", "q": "«Бұл үй __?»", "o": ["ме", "бе", "пе"], "mk": ["ба", "па"], "all": false, "wrong": null, "nosub": false, "id": "03-3"}, {"d": 3, "cat": "gram", "kk": "Бұл не? Бұл кітап.\nБұл кім? Бұл Айгерім.", "ru": "Что это? Это книга. Кто это? Это Айгерим.", "note": "«Не?» — заттар мен жануарларға, «Кім?» — адамдарға.", "q": "Мысық туралы қалай сұраймыз?", "o": ["Бұл не?", "Бұл кім?", "Бұл қай?"], "mk": ["не", "кім"], "all": false, "wrong": null, "nosub": false, "id": "03-4"}, {"d": 4, "cat": "dialog", "kk": "— Маған бір шай беріңізші.\n— Әрине! Тағы не аласыз?", "ru": "— Дайте мне, пожалуйста, чай. — Конечно! Что ещё возьмёте?", "note": "«-ізші» өтінішті жұмсартады: беріңіз → беріңізші.", "q": "«Беріңізші» қандай мағына береді?", "o": ["Сыпайы өтініш", "Бұйрық", "Сұрақ"], "mk": ["ізші"], "all": false, "wrong": null, "nosub": false, "id": "04-1"}, {"d": 4, "cat": "dialog", "kk": "— Сен қайдансың?\n— Мен Алматыданмын.", "ru": "— Откуда ты? — Я из Алматы.", "note": "«-дан/-ден» — откуда? Алматы + дан + мын.", "q": "«Я из Астаны»:", "o": ["Мен Астанаданмын", "Мен Астанадамын", "Мен Астанаменмін"], "mk": ["дансың", "данмын"], "all": false, "wrong": null, "nosub": false, "id": "04-2"}, {"d": 4, "cat": "dialog", "kk": "— Неше жастасың?\n— Он төрт жастамын.", "ru": "— Сколько тебе лет? — Мне четырнадцать.", "note": "Жасты айтқанда: «... жастамын».", "q": "«Мне 15 лет»:", "o": ["Он бес жастамын", "Он бес жылмын", "Он бес жаспын"], "mk": ["жастасың", "жастамын"], "all": false, "wrong": null, "nosub": false, "id": "04-3"}, {"d": 4, "cat": "dialog", "kk": "— Кешіріңіз, түсінбедім. Қайталаңызшы.\n— Әрине!", "ru": "— Извините, я не понял. Повторите, пожалуйста. — Конечно!", "note": "Түсінбесең, ұялма: «Қайталаңызшы».", "q": "«Повторите, пожалуйста»:", "o": ["Қайталаңызшы", "Айтыңыз", "Тыңдаңыз"], "mk": ["ызшы"], "all": false, "wrong": null, "nosub": false, "id": "04-4"}, {"d": 5, "cat": "aitylym", "kk": "Қала, қыз, қасық, қалам.", "ru": "город, девушка, ложка, ручка", "note": "Қ — тілдің түбімен айтылатын терең дыбыс.", "q": "Қай сөзде «қ» бар?", "o": ["қасық", "кітап", "көл"], "mk": ["Қ", "қ"], "all": true, "wrong": null, "nosub": false, "id": "05-1"}, {"d": 5, "cat": "aitylym", "kk": "Ағаш, бағыт, сағат, ғалым.", "ru": "дерево, направление, часы, учёный", "note": "Ғ — тамақтан шығатын жұмсақ дыбыс.", "q": "Қай сөзде «ғ» бар?", "o": ["сағат", "сабақ", "сахна"], "mk": ["Ғ", "ғ"], "all": true, "wrong": null, "nosub": false, "id": "05-2"}, {"d": 5, "cat": "aitylym", "kk": "Таң, мың, жаңа, оң.", "ru": "рассвет, тысяча, новый, правый", "note": "Ң — мұрын арқылы айтылады.", "q": "Қай сөзде «ң» бар?", "o": ["таң", "тау", "тас"], "mk": ["ң"], "all": true, "wrong": null, "nosub": false, "id": "05-3"}, {"d": 5, "cat": "aitylym", "kk": "Үй мен ұл, күн мен құм.", "ru": "дом и сын, солнце и песок", "note": "Ү — жіңішке, Ұ — жуан дыбыс.", "q": "«Песок» қазақша:", "o": ["құм", "күм", "кум"], "mk": ["ү", "Ү", "ұ"], "all": true, "wrong": null, "nosub": false, "id": "05-4"}, {"d": 6, "cat": "tyndalym", "kk": "Не жаңалық?", "ru": "Что нового?", "note": "Алдымен субтитрсіз тыңда.", "q": "Не деді?", "o": ["Что нового?", "Как дела?", "Где ты?"], "mk": [], "all": false, "wrong": null, "nosub": true, "id": "06-1"}, {"d": 6, "cat": "tyndalym", "kk": "Сау бол! Кездескенше!", "ru": "Пока! До встречи!", "note": "Қоштасу сөздері.", "q": "Не деді?", "o": ["Пока! До встречи!", "Привет! Как дела?", "Большое спасибо!"], "mk": [], "all": false, "wrong": null, "nosub": true, "id": "06-2"}, {"d": 6, "cat": "tyndalym", "kk": "Рахмет, үлкен рахмет!", "ru": "Спасибо, большое спасибо!", "note": "Алғыс айту.", "q": "Не деді?", "o": ["Большое спасибо!", "Извините!", "Пожалуйста!"], "mk": [], "all": false, "wrong": null, "nosub": true, "id": "06-3"}, {"d": 6, "cat": "tyndalym", "kk": "Қайырлы таң! Қалайсыз?", "ru": "Доброе утро! Как вы?", "note": "Таңертеңгі амандасу.", "q": "Не деді?", "o": ["Доброе утро! Как вы?", "Добрый вечер!", "Спокойной ночи!"], "mk": [], "all": false, "wrong": null, "nosub": true, "id": "06-4"}, {"d": 7, "cat": "sauat", "kk": "Қалайсың?", "ru": "Как ты?", "note": "Желідегі «каксын» тілге нұқсан келтіреді.", "q": "Қайсысы дұрыс?", "o": ["Қалайсың?", "Каксын?", "Калайсын?"], "mk": [], "all": false, "wrong": "каксын?", "nosub": false, "id": "07-1"}, {"d": 7, "cat": "sauat", "kk": "Қайырлы таң!", "ru": "Доброе утро!", "note": "Қ, ң әріптерін түсірмей жаз.", "q": "Қайсысы дұрыс?", "o": ["Қайырлы таң!", "Кайырлы таң!", "Қайырлы тан!"], "mk": ["Қ", "ң"], "all": true, "wrong": "кайырлы тан", "nosub": false, "id": "07-2"}, {"d": 7, "cat": "sauat", "kk": "Жақсы, рахмет!", "ru": "Хорошо, спасибо!", "note": "«жаксы» емес, «жақсы».", "q": "Қайсысы дұрыс?", "o": ["Жақсы", "Жаксы", "Жақсі"], "mk": ["Жақсы"], "all": false, "wrong": "жаксы, рахмет", "nosub": false, "id": "07-3"}, {"d": 7, "cat": "tusindir", "kk": "Сәлем — досыңа.\nСәлеметсіз бе — үлкенге.", "ru": "«Сәлем» — другу. «Сәлеметсіз бе» — старшему.", "note": "30 секундтық ролик: ережені айт, 3 мысал келтір, көрерменге сұрақ қой.", "q": "Роликті неден бастаймыз?", "o": ["Ережені бір сөйлеммен айтудан", "Ұзақ кіріспеден", "Әдебиеттер тізімінен"], "mk": [], "all": false, "wrong": null, "nosub": false, "id": "07-4"}, {"d": 8, "cat": "maqal", "kk": "Бірлік бар жерде — тірлік бар.", "ru": "Где единство — там и жизнь.", "note": "Ұйқас: бірлік — тірлік.", "q": "Мақалдың негізгі ойы:", "o": ["Бірлік — өмірдің негізі", "Жалғыз жүрген жақсы", "Жұмыс керек емес"], "mk": ["Бірлік", "тірлік"], "all": false, "wrong": null, "nosub": false, "id": "08-1"}, {"d": 8, "cat": "maqal", "kk": "Ата-анаңды сыйласаң, балаңнан сый көресің.", "ru": "Уважаешь родителей — получишь уважение от своих детей.", "note": "«Сыйлау» — құрметтеу.", "q": "«Сыйлау» дегені:", "o": ["Құрметтеу", "Сыйлық беру", "Сөйлеу"], "mk": ["сыйласаң"], "all": false, "wrong": null, "nosub": false, "id": "08-2"}, {"d": 8, "cat": "maqal", "kk": "Отан отбасынан басталады.", "ru": "Родина начинается с семьи.", "note": "«Отбасы» — семья.", "q": "«Отбасы» дегені:", "o": ["Семья", "Отечество", "Дом"], "mk": ["отбасынан"], "all": false, "wrong": null, "nosub": false, "id": "08-3"}, {"d": 8, "cat": "maqal", "kk": "Ырыс алды — ынтымақ.", "ru": "Начало благополучия — согласие.", "note": "«Ынтымақ» — татулық, бірлік.", "q": "«Ынтымақ» дегені:", "o": ["Татулық", "Байлық", "Еңбек"], "mk": ["ынтымақ"], "all": false, "wrong": null, "nosub": false, "id": "08-4"}, {"d": 9, "cat": "sozdik", "kk": "Мен қуаныштымын.\nШаршадым.\nКөңілім жоқ.", "ru": "Я рад. Я устал. Нет настроения.", "note": "Сезімді айт: «-мын», «-дым».", "q": "«Шаршадым» дегені:", "o": ["Я устал", "Я рад", "Я голоден"], "mk": ["мын", "дым"], "all": false, "wrong": null, "nosub": false, "id": "09-1"}, {"d": 9, "cat": "sozdik", "kk": "Бұл менің анам.\nБұл менің әкем.", "ru": "Это моя мама. Это мой папа.", "note": "«-м» — менің: анам, әкем.", "q": "«Мой старший брат»:", "o": ["менің ағам", "менің інім", "менің әпкем"], "mk": ["анам", "әкем"], "all": false, "wrong": null, "nosub": false, "id": "09-2"}, {"d": 9, "cat": "sozdik", "kk": "Әпке, аға, іні, сіңлі, қарындас.", "ru": "старшая сестра, старший брат, младший брат, младшая сестра девушки, младшая сестра парня", "note": "Қыздың сіңлісі, ер баланың қарындасы.", "q": "«Младший брат»:", "o": ["іні", "аға", "әпке"], "mk": [], "all": false, "wrong": null, "nosub": false, "id": "09-3"}, {"d": 9, "cat": "sozdik", "kk": "Мен сені сағындым!", "ru": "Я по тебе соскучился!", "note": "«Сағыну» — скучать по кому-то.", "q": "«Сағындым» дегені:", "o": ["Соскучился", "Устал", "Обрадовался"], "mk": ["сағындым"], "all": false, "wrong": null, "nosub": false, "id": "09-4"}, {"d": 10, "cat": "gram", "kk": "менің кітабым.\nсенің кітабың.\nоның кітабы.", "ru": "моя книга, твоя книга, его книга", "note": "Тәуелдік: -ым, -ың, -ы. Кітап → кітабым: «п» «б»-ға айналады.", "q": "«Қалам» — менің ___", "o": ["қаламым", "қаламың", "қаламы"], "mk": ["абым", "абың", "абы"], "all": false, "wrong": null, "nosub": false, "id": "10-1"}, {"d": 10, "cat": "gram", "kk": "Менің інім бар.\nМенің ағам жоқ.", "ru": "У меня есть младший брат. У меня нет старшего брата.", "note": "«бар» — есть, «жоқ» — нет.", "q": "«У меня нет кошки»:", "o": ["Менің мысығым жоқ", "Менің мысығым бар", "Мен мысық жоқ"], "mk": ["бар", "жоқ"], "all": false, "wrong": null, "nosub": false, "id": "10-2"}, {"d": 10, "cat": "gram", "kk": "Анам үйде.\nӘкем жұмыста.", "ru": "Мама дома. Папа на работе.", "note": "Жатыс септігі (где?): -да/-де, -та/-те.", "q": "«Мектеп» + жатыс:", "o": ["мектепте", "мектепде", "мектепта"], "mk": ["үйде", "жұмыста"], "all": false, "wrong": null, "nosub": false, "id": "10-3"}, {"d": 10, "cat": "gram", "kk": "Мен досыммен барамын.\nҚаламмен жазамын.", "ru": "Я иду с другом. Пишу ручкой.", "note": "Көмектес септігі (с кем? чем?): -мен/-бен/-пен.", "q": "«Қалам» + көмектес:", "o": ["қаламмен", "қаламбен", "қалампен"], "mk": ["ыммен", "аммен"], "all": false, "wrong": null, "nosub": false, "id": "10-4"}, {"d": 11, "cat": "dialog", "kk": "— Сенің бауырларың бар ма?\n— Иә, бір ағам, бір сіңлім бар.", "ru": "— У тебя есть братья и сёстры? — Да, старший брат и младшая сестра.", "note": "«Бауыр» — туған аға-іні, апа-сіңлі.", "q": "«Бауыр» мағынасы:", "o": ["Туған аға-іні, апа-сіңлі", "Дос", "Көрші"], "mk": ["бауырларың"], "all": false, "wrong": null, "nosub": false, "id": "11-1"}, {"d": 11, "cat": "dialog", "kk": "— Көңіл-күйің қалай?\n— Тамаша! Ал сенікі?", "ru": "— Как настроение? — Отлично! А у тебя?", "note": "«Сенікі» — твоё.", "q": "«А у тебя?»:", "o": ["Ал сенікі?", "Ал менікі?", "Ал оныкі?"], "mk": ["сенікі"], "all": false, "wrong": null, "nosub": false, "id": "11-2"}, {"d": 11, "cat": "dialog", "kk": "— Анаң не жұмыс істейді?\n— Анам дәрігер.", "ru": "— Кем работает твоя мама? — Мама врач.", "note": "Мамандықтар: дәрігер, мұғалім, аспазшы.", "q": "«Дәрігер» дегені:", "o": ["Врач", "Учитель", "Повар"], "mk": ["дәрігер"], "all": false, "wrong": null, "nosub": false, "id": "11-3"}, {"d": 11, "cat": "dialog", "kk": "— Туған күнің құтты болсын!\n— Рахмет, көп рахмет!", "ru": "— С днём рождения! — Спасибо большое!", "note": "«Құтты болсын» — құттықтау сөзі.", "q": "Туған күнде не дейміз?", "o": ["Туған күнің құтты болсын!", "Кешіріңіз!", "Сау бол!"], "mk": ["құтты"], "all": false, "wrong": null, "nosub": false, "id": "11-4"}, {"d": 12, "cat": "aitylym", "kk": "Әже, өрік, үй, ұл, із.", "ru": "бабушка, абрикос, дом, сын, след", "note": "Ерекше дауыстылар: ә, ө, ү, ұ, і.", "q": "«Үй» сөзінің аудармасы:", "o": ["дом", "сын", "след"], "mk": ["Ә", "ө", "ү", "ұ", "і"], "all": true, "wrong": null, "nosub": false, "id": "12-1"}, {"d": 12, "cat": "aitylym", "kk": "Көл мен қол,